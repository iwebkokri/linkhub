# Copy this file to ".env" and fill it in.   chmod 600 .env   (only your server user should read it)

NODE_ENV=production
PORT=4000

# REQUIRED. A long random value. It encrypts two-factor secrets and makes the anonymous visitor hashes.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep a copy in your password manager. If you ever change it, everyone's two-factor setup stops working
# (recover with: npm run admin -- reset <email> --disable-2fa). Login sessions are NOT affected by it.
APP_SECRET=

# The public address of the site, no trailing slash. REQUIRED in production:
#  - requests for any other host name are refused (stops host-header attacks)
#  - used for social-share previews
PUBLIC_URL=https://links.yourdomain.com
# Extra host names that may reach the site (comma separated), e.g. www.yourdomain.com
# ALLOWED_HOSTS=

# Behind Nginx / Cloudflare: 1 (so client IPs, HTTPS and rate limits work). Only trust a proxy you control.
TRUST_PROXY=1

# The app listens on 127.0.0.1 in production, so only Nginx (on the same machine) can reach it.
# Change only if you really need to (Docker sets 0.0.0.0 inside the container).
# HOST=127.0.0.1

# ---- Your first administrator ---------------------------------------------------------------
# Easiest and safest: leave these out and create the admin from the server's command line instead
# (the password is then generated and printed once, and never written to a file):
#     cd server && npm run admin -- create you@yourdomain.com --name "Your Name" --generate
# Or fill these in; they are only used the first time, when the database has no users:
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Security policy (defaults shown) --------------------------------------------------------
# Administrators must set up an authenticator app (2FA) before they can do anything. Default: true in production.
# REQUIRE_2FA_FOR_ADMINS=true
# Sessions end after this many hours, or after this many idle minutes.
# SESSION_MAX_HOURS=12
# SESSION_IDLE_MINUTES=120
# Cookie "Secure" flag: auto (default: Secure when the request arrived over HTTPS) | true | false
# COOKIE_SECURE=auto

# Words that must not appear in short passwords (comma separated), e.g. your company / product name.
# WEAK_PASSWORD_WORDS=yourcompany,linkhub

# ---- Link safety ------------------------------------------------------------------------------
# Websites that may never be linked (comma separated; subdomains included).
# BLOCKED_LINK_DOMAINS=bit.ly,example-phish.com
# Domain names with look-alike (international) characters are blocked by default. Set true to allow them.
# ALLOW_PUNYCODE_LINKS=false
# MAX_LINKS_PER_BUSINESS=100

# ---- Statistics & data ------------------------------------------------------------------------
# Time zone that decides where one "day" ends in the traffic statistics (an IANA name).
STATS_TIMEZONE=America/Toronto
# Delete individual visit/click records older than this (all-time totals are kept). 0 = keep forever.
# STATS_RETENTION_DAYS=730
# AUDIT_RETENTION_DAYS=730
# Repeat views / clicks from the same visitor within this many seconds are ignored.
# STATS_VIEW_DEDUPE_SECONDS=30
# STATS_CLICK_DEDUPE_SECONDS=2

# Extra hosts the browser may load scripts / send data to, e.g. tags you add inside Google Tag Manager
# (space or comma separated). Google, Meta and TikTok are already allowed.
# CSP_EXTRA_SOURCES=https://snap.licdn.com https://static.hotjar.com

# Where the SQLite database and uploaded images live. Back this folder up.
# DATA_DIR=./data
