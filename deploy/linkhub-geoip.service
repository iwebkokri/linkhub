# /etc/systemd/system/linkhub-geoip.service  - refreshes the visitor-location database (run by linkhub-geoip.timer)
[Unit]
Description=LinkHub: refresh the visitor-location database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=linkhub
Group=linkhub
WorkingDirectory=/var/www/linkhub/app/server
EnvironmentFile=/var/www/linkhub/app/server/.env
ExecStart=/var/www/linkhub/runtime/node/bin/node scripts/update-geoip.mjs
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/linkhub/app/server/data
UMask=0027
